# Credentials for testing against a real Asterisk, used by the asterisk-host
# integration tests and the sb-e2e lab tier.
# Copy this file to .env.integration and fill in your values.
# Never commit .env.integration — it is listed in .gitignore.
#
# Load before running integration tests in asterisk-host:
#   source ../plugin-asterisk/.env.integration
#   go test -tags integration -v ./internal/ari/...

ASTERISK_ARI_URL=http://<host>:8088
ASTERISK_ARI_USER=<username>
ASTERISK_ARI_PASS=<password>
ASTERISK_TEST_SIGNING_KEY=<openssl rand -hex 32>
